<!--
  Cowrie honeypot detection rules for Wazuh
  Copy to: /var/ossec/etc/rules/cowrie_rules.xml  (inside the wazuh.manager container)

  Custom rule IDs must be in the 100000-120000 range.
  Levels: 0-4 informational, 5-9 suspicious, 10-15 high severity (alert-worthy)

  Cowrie writes JSON, so Wazuh's built-in JSON decoder extracts every key
  automatically. In rules you reference them by name (eventid, src_ip, ...);
  in the dashboard they appear as data.eventid, data.src_ip, ...
-->
<group name="cowrie,honeypot,">

  <!-- ── Base rule: anything that came from Cowrie ─────────────────────────── -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.</field>
    <description>Cowrie honeypot event (grouping rule)</description>
  </rule>

  <!-- ── Reconnaissance / initial access ───────────────────────────────────── -->
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.session.connect$</field>
    <description>Cowrie: new connection from $(src_ip)</description>
    <group>connection_attempt,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie: failed login as '$(username)' from $(src_ip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- Correlation: 10 failed logins from the SAME IP inside 2 minutes -->
  <rule id="100103" level="10" frequency="10" timeframe="120">
    <if_matched_sid>100102</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: SSH brute force from $(src_ip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: attacker logged in as '$(username)' from $(src_ip)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <!-- ── Post-exploitation: commands ───────────────────────────────────────── -->
  <rule id="100110" level="6">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: command from $(src_ip): $(input)</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <!-- Children of 100110: more specific behaviour inside the command text -->
  <rule id="100111" level="7">
    <if_sid>100110</if_sid>
    <field name="input" type="pcre2">(?i)\b(uname|nproc|lscpu|/proc/cpuinfo|free -m|whoami|id)\b</field>
    <description>Cowrie: system discovery from $(src_ip)</description>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>

  <rule id="100112" level="12">
    <if_sid>100110</if_sid>
    <field name="input" type="pcre2">authorized_keys</field>
    <description>Cowrie: SSH key persistence attempt from $(src_ip)</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
  </rule>

  <rule id="100113" level="12">
    <if_sid>100110</if_sid>
    <field name="input" type="pcre2">(?i)crontab|/etc/cron</field>
    <description>Cowrie: cron persistence attempt from $(src_ip)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>

  <rule id="100114" level="12">
    <if_sid>100110</if_sid>
    <field name="input" type="pcre2">(?i)xmrig|minerd|stratum\+tcp|cryptonight</field>
    <description>Cowrie: cryptominer deployment from $(src_ip)</description>
    <mitre>
      <id>T1496</id>
    </mitre>
  </rule>

  <rule id="100115" level="10">
    <if_sid>100110</if_sid>
    <field name="input" type="pcre2">(?i)(wget|curl|tftp)\s</field>
    <description>Cowrie: tool download command from $(src_ip)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- ── Malware actually fetched ──────────────────────────────────────────── -->
  <rule id="100120" level="13">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie.session.file_download$</field>
    <description>Cowrie: malware downloaded from $(url) (sha256 $(shasum))</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>malware,</group>
  </rule>

</group>
